<Window x:Class="Test.IconFonts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Test.IconFonts"
        xmlns:controls="clr-namespace:Test.IconFonts.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow"
        Width="800"
        Height="450"
        mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  纯色图标。使用IconFont  -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <TextBlock FontFamily="{DynamicResource IconFont}"
                       FontSize="30"
                       Foreground="Blue"
                       Text="&#xe98d;"
                       VerticalAlignment="Center" />
            <TextBlock FontFamily="{DynamicResource IconFont}"
                       FontSize="30"
                       Foreground="Blue"
                       Text="&#xe98b;"
                       VerticalAlignment="Center" />
            <TextBlock FontFamily="{DynamicResource IconFont}"
                       FontSize="30"
                       Foreground="Blue"
                       Text="&#xe992;"
                       VerticalAlignment="Center" />
            <TextBlock FontFamily="{DynamicResource IconFont}"
                       FontSize="30"
                       Foreground="Red"
                       Text="&#xe98c;"
                       VerticalAlignment="Center" />
            <controls:IconFontRadioButton IconFontContent="&#xe98c;"
                                          IconFontForeground="Blue"
                                          IconFontSize="30"
                                          FontSize="20"
                                          Foreground="Red"
                                          Content="测试"
                                          TextLocation="Bottom"
                                          Width="80"
                                          Height="60" />
            <controls:IconFontRadioButton IconFontContent="&#xe98c;"
                                          IconFontForeground="Blue"
                                          IconFontSize="30"
                                          TextLocation="Right"
                                          IconFontSpacing="10"
                                          FontSize="20"
                                          Foreground="Red"
                                          Content="测试"
                                          Width="80"
                                          Height="60" />
            <controls:IconFontRadioButton IconFontContent="&#xe98c;"
                                          IconFontForeground="Blue"
                                          IconFontSize="30"
                                          FontSize="20"
                                          Foreground="Red"
                                          Content="测试"
                                          TextLocation="None"
                                          Width="80"
                                          Height="60" />
        </StackPanel>

        <!--  彩色图标。使用DrawingImage，用SharpVectors从svg导出的资源  -->
        <StackPanel Grid.Column="1">
            <Image Source="{StaticResource Icon_Volleyball}"
                   Width="124"
                   VerticalAlignment="Center" />
        </StackPanel>

        <!--  使用DrawingImage，用SharpVectors从svg导出的资源  -->
        <StackPanel Grid.Column="2"
                    Background="Black"
                    Orientation="Vertical">
            <ToggleButton Style="{StaticResource VolumeTogl}" />
            <ToggleButton Style="{StaticResource ArrowTogl}" />
        </StackPanel>

        <!--  使用Path作为图标  -->
        <Path Grid.Column="3"
